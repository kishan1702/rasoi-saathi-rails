# Set these in Vercel: Project -> Settings -> Environment Variables, then redeploy.

# Required. Any long random string. Callers must send it (Authorization: Bearer <key>, x-api-key, or ?key=).
# Until it is set, the mocks work without a key and the real connectors stay switched off.
RASOI_API_KEY=

# Telegram (tg_* tools, and voice notes for gnani_stt_transcribe). From @BotFather.
TELEGRAM_BOT_TOKEN=

# Gnani Vachana (gnani_* tools).
GNANI_API_KEY=
# Optional: GNANI_TTS_VOICE=Nalini  GNANI_TTS_MODEL=timbre-v2.5  GNANI_STT_FORMAT=verbatim

# Google Sheets (sheets_* tools). Paste the whole service-account JSON key (or its base64).
# Then share the household workbook with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: only allow these spreadsheet ids (comma separated).
SHEETS_ALLOWED_IDS=

# Gmail (gmail_* tools, read-only). OAuth client + a refresh token with scope gmail.readonly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: durable state for the Pine Labs / Delhivery mocks (Upstash Redis or Vercel KV REST).
# Without it, orders and shipments live in memory and are lost when the function goes cold.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional mock tuning
# MOCK_MANDATE_MONTHLY_CAP=15000  MOCK_MANDATE_PER_ORDER_CAP=2500  MOCK_MANDATE_EXPIRES_AT=2027-12-31
# DLV_UNSERVICEABLE_PINS=700150,700151   DLV_DELIVERY_MINUTES=40
